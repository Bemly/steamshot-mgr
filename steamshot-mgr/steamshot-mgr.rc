// steamshot-mgr.rc —— 资源脚本(图标 / 对话框 / 加速键 / 版本信息)
#include <windows.h>
#include <afxres.h>
#include "resource.h"

LANGUAGE LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED
#pragma code_page(65001)

IDR_MAINFRAME ICON "res\\steamshot-mgr.ico"

IDD_PREVIEW DIALOGEX 0, 0, 640, 480
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU | WS_MAXIMIZEBOX | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "预览"
BEGIN
END

IDD_IMPORT DIALOGEX 0, 0, 520, 400
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_THICKFRAME | WS_SYSMENU | WS_MAXIMIZEBOX | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "导入截图"
FONT 9, "Segoe UI"
BEGIN
END

IDD_DATE_EDIT DIALOGEX 0, 0, 180, 70
STYLE DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "修改日期"
FONT 9, "Segoe UI"
BEGIN
    CONTROL "", IDC_IMP_DATE, "SysDateTimePick32", DTS_RIGHTALIGN, 10, 10, 160, 22
    DEFPUSHBUTTON "确定", IDOK, 20, 42, 60, 18
    PUSHBUTTON "取消", IDCANCEL, 100, 42, 60, 18
END

IDR_MAINFRAME ACCELERATORS
BEGIN
    "R", ID_VIEW_REFRESH, VIRTKEY, CONTROL
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "FileDescription", "Steam 截图管理器(只读)"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "steamshot-mgr"
            VALUE "OriginalFilename", "steamshot-mgr.exe"
            VALUE "ProductName", "steamshot-mgr"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x804, 1200
    END
END
